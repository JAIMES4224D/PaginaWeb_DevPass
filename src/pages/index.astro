---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Card from '../components/card.astro';

const baseUrl = import.meta.env.BASE_URL;
const profilePicture = `${baseUrl}fotoP.png`;
const logoBrand = `${baseUrl}logo_devpass.jpg`;
---
<Layout 
  title="DevPass | Transforma tu código en arte digital" 
  description="Sigue a DevPass en YouTube, TikTok, GitHub, Discord, Kick y LinkedIn. Arquitectura de software, ciberseguridad y contenido tech de alto valor para developers."
>
  <main class="max-w-6xl mx-auto px-6 py-16 md:py-24 relative">
    
    <!-- HERO SECTION -->
    <header class="text-center mb-20">
      
      <!-- Contenedor del perfil con badge del logo -->
      <div class="relative inline-flex items-center justify-center mb-10 w-48 h-48 md:w-56 md:h-56 mx-auto">
        <div class="absolute inset-0 bg-cyber-blue blur-[60px] opacity-20 animate-pulse rounded-full"></div>
        <div class="relative w-full h-full">
          <img 
            src={profilePicture} 
            alt="Jeferson Jaimes Passuni | DevPass" 
            class="w-full h-full rounded-full border-3 border-cyber-blue/60 p-1 shadow-[0_0_45px_rgba(0,194,255,0.5)] object-cover bg-slate-900"
            width="224"
            height="224"
            loading="eager"
            decoding="async"
          />
          <div class="absolute -bottom-1 -right-1 bg-slate-900/80 backdrop-blur-md p-1.5 rounded-xl border border-cyber-blue shadow-lg shadow-cyber-blue/20">
            <img 
              src={logoBrand} 
              alt="DevPass Logo" 
              class="w-10 h-10 md:w-12 md:h-12 object-contain"
              width="48"
              height="48"
              loading="lazy"
            />
          </div>
        </div>
      </div>
      
      <!-- Título con efecto de escritura tipo terminal -->
      <h1 class="text-5xl md:text-7xl font-black text-white tracking-tighter uppercase mb-4 cyber-text-glow">
        <span id="typing-container">
          <span id="typing-text"></span><span id="typing-cursor" class="text-cyber-blue animate-cursor-blink" style="text-shadow: 0 0 10px currentColor, 0 0 20px currentColor;">_</span>
        </span>
      </h1>
      
      <p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed mb-10 font-light">
        De <span class="text-white font-semibold">SysAdmin a Software Engineer</span>. Te enseño a construir sistemas robustos, fortificar tu ciberseguridad y a pensar como un arquitecto de software. <span class="text-cyber-blue font-semibold">#DeJuniorASenior</span>
      </p>

      <div class="flex justify-center flex-wrap gap-3 text-[11px] md:text-xs font-mono text-cyber-blue uppercase tracking-[0.2em]">
        <span class="bg-cyber-blue/5 px-4 py-2 border border-cyber-blue/20 rounded-full backdrop-blur-sm">[ Software Eng ]</span>
        <span class="bg-cyber-blue/5 px-4 py-2 border border-cyber-blue/20 rounded-full backdrop-blur-sm">[ Cyber Security ]</span>
        <span class="bg-cyber-blue/5 px-4 py-2 border border-cyber-blue/20 rounded-full backdrop-blur-sm">[ Systems Analyst ]</span>
      </div>
    </header>

    <!-- REDES SOCIALES (7 tarjetas en 3 columnas) -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      
      <Card 
        title="YouTube" 
        desc="Arquitectura de software y Spring Boot desde cero. Code reviews, proyectos reales y mi camino como dev." 
        href="https://youtube.com/@DevPass-fm5gn" 
        icon="fa-brands fa-youtube" 
        stats="138 Subs" 
        ctaText="Ver Tutoriales"
      />
      
      <Card 
        title="TikTok" 
        desc="Píldoras de 60 segundos con hacks de código, configuraciones de terminal y soluciones IT." 
        href="https://tiktok.com/@devpass_oficial" 
        icon="fa-brands fa-tiktok" 
        stats="239 Seg" 
        ctaText="Seguir en TikTok"
      />
      
      <Card 
        title="GitHub" 
        desc="Código fuente de mis proyectos, scripts de automatización y dotfiles." 
        href="https://github.com/JAIMES4224D" 
        icon="fa-brands fa-github" 
        stats="Dev Projects" 
        ctaText="Ver Código"
      />
      
      <Card 
        title="Discord" 
        desc="Únete a la comunidad DevPass. Soporte técnico, networking, eventos exclusivos y canales de voz. ¡Aquí se cocina el futuro!" 
        href="https://discord.gg/AZuGJwrPp" 
        icon="fa-brands fa-discord" 
        stats="Comunidad" 
        ctaText="Unirse al Server"
      />
      
      <Card 
        title="Kick" 
        desc="Directos de programación en vivo, resolución de dudas y construcción de proyectos en tiempo real. Programa conmigo." 
        href="https://kick.com/developerpass" 
        icon="fa-solid fa-gamepad" 
        stats="En vivo" 
        ctaText="Seguir en Kick"
      />
      
      <Card 
        title="LinkedIn" 
        desc="Conecta conmigo a nivel profesional. Colaboraciones, oportunidades laborales y mi perfil como Software Engineer." 
        href="https://www.linkedin.com/company/108571674/admin/dashboard/" 
        icon="fa-brands fa-linkedin" 
        stats="Networking" 
        ctaText="Conectar"
      />
      
      <Card 
        title="Newsletter" 
        desc="Cada semana, un email con noticias IT, recursos exclusivos y análisis de tendencias. Sin spam, solo valor." 
        href="#newsletter" 
        icon="fa-solid fa-envelope" 
        stats="Próximamente" 
        ctaText="Apuntarme"
      />
      
    </section>

    <!-- SECCIÓN "SOBRE MÍ" -->
    <section class="cyber-border p-8 md:p-10 mb-20 text-center md:text-left relative overflow-hidden group">
      <div class="absolute top-0 right-0 w-48 h-48 bg-cyber-blue/10 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/2 group-hover:bg-cyber-blue/20 transition-colors duration-700"></div>
      
      <div class="relative flex flex-col md:flex-row items-center gap-8">
        <div class="w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden flex-shrink-0 border-2 border-slate-700 shadow-lg group-hover:border-cyber-blue/50 transition-colors duration-500">
          <img 
            src={profilePicture} 
            alt="Jeferson Jaimes Passuni - Foto de perfil" 
            class="object-cover w-full h-full"
            width="128" 
            height="128" 
            loading="lazy" 
          />
        </div>
        
        <div>
          <h2 class="text-3xl font-black text-white tracking-tight mb-3 group-hover:text-cyber-blue transition-colors duration-300">
            Un ingeniero, un teclado y una idea.
          </h2>
          <p class="text-slate-400 leading-relaxed mb-6">
            Soy <span class="text-white font-semibold">Jeferson Jaimes Passuni</span>, el creador de DevPass. Llevo más de 5 años en el mundo IT tocando servidores, escribiendo código y rompiendo cosas (para luego arreglarlas). 
            Mi misión en YouTube y redes es <span class="text-cyber-blue font-semibold">democratizar el conocimiento técnico de alto nivel</span> y ayudarte a saltar al siguiente nivel en tu carrera tech.
          </p>
          
          <div class="flex flex-wrap justify-center md:justify-start gap-4">
            <span class="text-xs text-slate-500 bg-slate-800/50 px-3 py-1 rounded-full border border-slate-700/30">🐧 Linux Addict</span>
            <span class="text-xs text-slate-500 bg-slate-800/50 px-3 py-1 rounded-full border border-slate-700/30">☕ Java & Spring</span>
            <span class="text-xs text-slate-500 bg-slate-800/50 px-3 py-1 rounded-full border border-slate-700/30">🛡️ SecOps</span>
            <span class="text-xs text-slate-500 bg-slate-800/50 px-3 py-1 rounded-full border border-slate-700/30">⚡ Astro Enjoyer</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA PRINCIPAL (YouTube) -->
    <footer class="text-center pb-10">
      <a 
        href="https://youtube.com/@DevPass-fm5gn?sub_confirmation=1" 
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex items-center justify-center px-10 py-5 font-black text-cyber-blue uppercase tracking-[0.15em] text-sm transition-all duration-500 overflow-hidden border-2 border-cyber-blue/50 rounded-full hover:text-white hover:border-cyber-blue shadow-[0_0_25px_rgba(0,194,255,0.15)] hover:shadow-cyber-blue/50"
      >
        <span class="absolute inset-0 w-full h-full bg-cyber-blue transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left -z-10"></span>
        <i class="fa-brands fa-youtube mr-3 text-lg"></i>
        Suscríbete al canal principal
      </a>
      <p class="mt-3 text-xs text-slate-600 font-light">+138 desarrolladores ya están dentro. ¿A qué esperas?</p>
      
      <div class="mt-16 flex flex-col items-center gap-2">
        <div class="w-24 h-[1px] bg-gradient-to-r from-transparent via-slate-700 to-transparent"></div>
        <p class="text-[9px] text-slate-600 tracking-[1em] uppercase font-bold">
          DevPass Digital Solutions © 2026
        </p>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* Animación del logo giratorio (por si se usa) */
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }

  /* Cursor de terminal con parpadeo brusco y glow */
  @keyframes cursor-blink {
    0%, 100% {
      opacity: 1;
      text-shadow: 0 0 10px currentColor, 0 0 20px currentColor;
    }
    50% {
      opacity: 0;
      text-shadow: none;
    }
  }
  .animate-cursor-blink {
    animation: cursor-blink 1s step-end infinite;
    display: inline-block;
    font-weight: 100;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-cursor-blink,
    .animate-spin-slow {
      animation: none;
    }
  }
</style>

<!-- Script para el efecto de escritura tipo terminal con bucle -->
<script>
  (function() {
    const text = "DevPass";
    const typingTextElement = document.getElementById('typing-text');
    const cursorElement = document.getElementById('typing-cursor');
    
    if (!typingTextElement || !cursorElement) return;
    
    const typingSpeed = 150; // ms por carácter
    const pauseAfterComplete = 1000; // pausa antes de borrar (1 segundo)
    const deleteSpeed = 80; // ms por carácter al borrar
    
    let index = 0;
    let isDeleting = false;
    
    function type() {
      if (!isDeleting) {
        // Fase de escritura
        if (index < text.length) {
          typingTextElement.textContent += text.charAt(index);
          index++;
          // Cursor fijo momentáneamente para simular "escribiendo"
          cursorElement.classList.remove('animate-cursor-blink');
          void cursorElement.offsetWidth;
          cursorElement.classList.add('animate-cursor-blink');
          setTimeout(type, typingSpeed);
        } else {
          // Texto completo: pausa y luego empezar a borrar
          cursorElement.classList.add('animate-cursor-blink');
          isDeleting = true;
          setTimeout(type, pauseAfterComplete);
        }
      } else {
        // Fase de borrado
        if (index > 0) {
          typingTextElement.textContent = text.substring(0, index - 1);
          index--;
          cursorElement.classList.remove('animate-cursor-blink');
          void cursorElement.offsetWidth;
          cursorElement.classList.add('animate-cursor-blink');
          setTimeout(type, deleteSpeed);
        } else {
          // Borrado completo: volver a escribir
          typingTextElement.textContent = '';
          isDeleting = false;
          cursorElement.classList.add('animate-cursor-blink');
          setTimeout(type, typingSpeed);
        }
      }
    }
    
    // Iniciar después de un pequeño delay
    setTimeout(type, 500);
  })();
</script>
