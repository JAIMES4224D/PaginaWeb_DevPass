---
// src/components/Card.astro
interface Props {
  title: string;
  desc: string;
  href: string;
  icon: string;
  stats: string;
  ctaText?: string; // Texto de llamada a la acción
}
// Asignamos un valor por defecto más descriptivo si no se pasa ctaText
const { title, desc, href, icon, stats, ctaText = `Ir a ${title}` } = Astro.props;
---
<a href={href} target="_blank" rel="noopener noreferrer" class="cyber-border group flex flex-col p-6 h-full justify-between">
  <!-- Cabecera de la tarjeta -->
  <div>
    <div class="flex justify-between items-start mb-6">
      <div class="p-3 bg-cyber-dark border border-slate-700/50 rounded-xl group-hover:border-cyber-blue transition-colors duration-500 shadow-lg">
        <i class={`${icon} text-3xl text-cyber-blue group-hover:scale-110 transition-transform duration-300`}></i>
      </div>
      <div class="text-right">
        <span class="flex items-center gap-1.5 text-[10px] text-emerald-400/80 font-mono uppercase tracking-wider">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          Online
        </span>
        <span class="block text-[10px] text-slate-500 font-mono uppercase mt-1">{stats}</span>
      </div>
    </div>
    
    <h3 class="text-2xl font-black text-white tracking-tight group-hover:text-cyber-blue transition-colors duration-300">
      {title}
    </h3>
    <p class="text-sm text-slate-400 mt-2 font-light leading-relaxed group-hover:text-slate-200 transition-colors duration-300">
      {desc}
    </p>
  </div>
  
  <!-- CTA específico de la tarjeta -->
  <div class="mt-6">
    <div class="h-[1px] w-full bg-gradient-to-r from-slate-800 via-slate-700 to-slate-800 group-hover:from-cyber-blue/50 group-hover:via-cyber-blue group-hover:to-cyber-blue/50 transition-all duration-700 mb-4"></div>
    <span class="inline-flex items-center text-xs font-bold text-slate-500 group-hover:text-cyber-blue transition-colors duration-300 uppercase tracking-widest">
      {ctaText}
      <i class="fas fa-arrow-right ml-2 -rotate-45 group-hover:rotate-0 transition-transform duration-300"></i>
    </span>
  </div>
</a>