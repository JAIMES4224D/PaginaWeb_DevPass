---
// src/components/GlowBackground.astro
// Componente para encapsular los efectos de fondo. Mejora el rendimiento al aislar las animaciones.
---
<div class="fixed inset-0 -z-20 overflow-hidden pointer-events-none" aria-hidden="true">
  <!-- CAPA 1: Grid Técnico -->
  <div 
    class="absolute inset-0 opacity-30"
    style="background-image: linear-gradient(rgba(0, 194, 255, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 194, 255, 0.08) 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <!-- CAPA 2: Resplandor animado (usaremos una animación con transform para mejor rendimiento) -->
  <div 
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[70vw] h-[70vh] bg-cyber-blue/10 rounded-full blur-[120px] animate-pulse-glow"
  ></div>
</div>

<style>
  /* Usamos animation con opacidad y escala, que es más performante que las que afectan al layout */
  @keyframes pulse-glow {
    0%, 100% {
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0.5;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.3);
      opacity: 0.9;
    }
  }
  .animate-pulse-glow {
    animation: pulse-glow 10s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate;
    will-change: transform, opacity;
  }
</style>